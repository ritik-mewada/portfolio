# Public URL of the deployed site (used for canonical links, sitemap and OG tags)
NEXT_PUBLIC_SITE_URL=https://ritikmewada.vercel.app

# Optional: raises the GitHub API rate limit for the "Recently on GitHub" section
GITHUB_TOKEN=

# Optional: enables the contact form to send email via https://resend.com
# Without it, the form falls back to opening the visitor's email client.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ritikmewada@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
