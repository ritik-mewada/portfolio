# Public URL of the deployed site (used for canonical links, sitemap and OG tags).
# The deploy workflow sets it from the GitHub Pages URL; override with the SITE_URL repository variable.
NEXT_PUBLIC_SITE_URL=https://ritik-mewada.github.io

# Sub-path the site is served from: empty for a user site (user.github.io), "/repo" for a project site.
# Set automatically by the deploy workflow.
NEXT_PUBLIC_BASE_PATH=

# Optional: raises the GitHub API rate limit for the "Recently on GitHub" section
GITHUB_TOKEN=

# Optional: lets the contact form send email via https://web3forms.com (free access key).
# Without it, the form falls back to opening the visitor's email client.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: Umami website ID for custom event analytics (https://cloud.umami.is)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
